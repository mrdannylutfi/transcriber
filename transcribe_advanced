    def check_os_and_adapt(self):
        """Dynamically detects the OS and adjusts context logs."""
        if os.name == "nt":
            self.status_label.config(text="Status: Windows environment. Ready.")
        else:
            self.status_label.config(text="Status: Unix environment. Ready.")

    def get_video_duration(self, filepath: str) -> float:
        """Queries FFmpeg/FFprobe internally to isolate exact duration for metrics matching."""
        # Uses ffmpeg to parse metadata info safely without extra ffprobe packaging dependency
        cmd = [self.ffmpeg_cmd, "-i", filepath]
        startupinfo = None
        if os.name == "nt":
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW

        process = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, startupinfo=startupinfo
        )
        output = process.stderr.decode("utf-8", errors="ignore")
        
        match = re.search(r"Duration:\s*(\d+):(\d+):(\d+)\.(\d+)", output)
        if match:
            hours, minutes, seconds, hundredths = map(int, match.groups())
            return hours * 3600 + minutes * 60 + seconds + hundredths / 100.0
        return 0.0

    def select_file(self):
        """Opens a file dialog to choose a video file and maps total length metrics."""
        file_types = [
            ("Video Files", "*.mp4 *.mkv *.avi *.mov *.flv"),
            ("All Files", "*.*"),
        ]
        selected = filedialog.askopenfilename(filetypes=file_types)
        if selected:
            self.video_path = selected
            self.file_label.config(
                text=os.path.basename(selected), foreground="black"
            )
            self.total_duration = self.get_video_duration(selected)
            self.process_btn.config(state="normal")
            self.status_label.config(text=f"Status: Loaded video ({int(self.total_duration)}s). Ready.")

    def cleanPath(self):
        return Path(self.video_path).with_suffix("")

    def extract_audio_with_progress(self, output_wav_path: str):
        """Optimized audio extractor tracking FFmpeg time-stamps to drive increments."""
        command = [
            self.ffmpeg_cmd,
            "-y",
            "-threads", "0",
            "-i", self.video_path,
            "-vn",
            "-ac", "1",
            "-ar", "16000",
            "-c:a", "pcm_s16le",
            output_wav_path,
        ]

        startupinfo = None
        if os.name == "nt":
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW

        # Read FFmpeg's stderr stream progressively to calculate execution speed metrics
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            startupinfo=startupinfo,
            universal_newlines=True,
            errors="ignore"
        )

        start_time = time.time()
        
        while True:
            # FFmpeg reports updates line by line via stderr loop
            line = process.stderr.readline()
            if not line and process.poll() is not None:
                break
            
            if "time=" in line:
                match = re.search(r"time=(\d+):(\d+):(\d+)\.(\d+)", line)
                if match and self.total_duration > 0:
                    hours, minutes, seconds, hundredths = map(int, match.groups())
                    current_secs = hours * 3600 + minutes * 60 + seconds + hundredths / 100.0
                    
                    # Update progress bars safely via threading bounds
                    progress_pct = min((current_secs / self.total_duration) * 100, 100)
                    elapsed = time.time() - start_time
                    
                    if current_secs > 0:
                        eta_secs = int((elapsed / current_secs) * (self.total_duration - current_secs))
                        self.root.after(0, lambda p=progress_pct, e=eta_secs: self.update_progress("Extracting", p, e))

        if process.returncode != 0:
            raise RuntimeError("FFmpeg extraction pipeline failed.")

