    def format_srt_timestamp(self, seconds: float) -> str:
        """Converts raw floating seconds into strict standard SRT timestamp formatting: HH:MM:SS,mmm"""
        hrs = int(seconds // 3600)
        mins = int((seconds % 3600) // 60)
        secs = int(seconds % 60)
        millis = int((seconds - int(seconds)) * 1000)
        return f"{hrs:02d}:{mins:02d}:{secs:02d},{millis:03d}"

    def start_processing_thread(self):
        self.process_btn.config(state="disabled")
        self.export_btn.config(state="disabled")
        self.text_area.delete("1.0", tk.END)
        self.progress_bar["value"] = 0
        self.eta_label.config(text="ETA: Calculating...")
        threading.Thread(target=self.process_pipeline, daemon=True).start()

